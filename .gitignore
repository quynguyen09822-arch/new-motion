node_modules/

# Bản nháp đang sửa dở và kho sao lưu — dữ liệu chạy, không phải mã nguồn.
.drafts/
.hub-video-backups/

# Do skill /port sinh ra.
.port
.port.pid
.port.log

# Clip 15 giây đã giao: file mp4 8 MB, không đưa vào git.
clip-15s/*.mp4

# Ảnh do máy kiểm chụp.
.kiem/
__pycache__/

# Mật khẩu (băm) và khoá ký phiên đăng nhập — KHÔNG bao giờ commit
.env
.env.*
# ...trừ BẢN MẪU. `.env.*` ở trên nuốt luôn `.env.example`, nên người mới clone
# về không có gì để biết phải khai những biến nào — mà file mẫu thì chỉ có tên
# biến và chú thích, không có giá trị thật nào.
!.env.example
mcp-stitch.json.txt

# Nhật ký lượt dùng — dữ liệu chạy.
.nhat-ky/
